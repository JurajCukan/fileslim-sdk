{
  "name": "@fileslim/compress",
  "version": "2.3.0",
  "description": "Client-side image and PDF compression. Zero servers, complete privacy.",
  "author": "Juraj Cukan",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "vitest",
    "test:smoke": "vitest run --reporter=verbose",
    "test:watch": "vitest --watch",
    "prepublishOnly": "npm run build && npm run test:smoke"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "@jsquash/avif": "^2.1.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@jsquash/jpeg": {
      "optional": true
    },
    "@jsquash/png": {
      "optional": true
    },
    "@jsquash/webp": {
      "optional": true
    },
    "@jsquash/avif": {
      "optional": true
    },
    "@jsquash/oxipng": {
      "optional": true
    },
    "@jsquash/jxl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.5.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "terser": "^5.44.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jurajcukan/fileslim-sdk"
  },
  "bugs": {
    "url": "https://github.com/jurajcukan/fileslim-sdk/issues"
  },
  "homepage": "https://fileslim.com",
  "keywords": [
    "compression",
    "image",
    "pdf",
    "client-side",
    "webp",
    "avif",
    "browser",
    "jpeg",
    "png",
    "optimize",
    "resize"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false
}
