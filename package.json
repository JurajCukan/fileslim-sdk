{
  "name": "@fileslim/compress",
  "version": "2.0.1",
  "description": "Client-side file compression library - compress images and PDFs in the browser with zero server costs",
  "author": "FileSlim",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "compression",
    "image",
    "pdf",
    "browser",
    "client-side",
    "webp",
    "jpeg",
    "png"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JurajCukan/fileslim-sdk"
  },
  "homepage": "https://fileslim.com/sdk",
  "bugs": {
    "url": "https://github.com/JurajCukan/fileslim-sdk/issues"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@jsquash/jpeg": { "optional": true },
    "@jsquash/png": { "optional": true },
    "@jsquash/webp": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "terser": "^5.44.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  }
}
