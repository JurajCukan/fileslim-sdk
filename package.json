{
  "name": "@fileslim/compress",
  "version": "2.0.1",
  "description": "Client-side image and PDF compression. Zero servers, complete privacy.",
  "author": "Juraj Cukan",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1"
  },
  "peerDependenciesMeta": {
    "@jsquash/jpeg": {
      "optional": true
    },
    "@jsquash/png": {
      "optional": true
    }
  },
  "devDependencies": {
    "terser": "^5.44.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jurajcukan/fileslim-sdk"
  },
  "bugs": {
    "url": "https://github.com/jurajcukan/fileslim-sdk/issues"
  },
  "homepage": "https://fileslim.com",
  "keywords": [
    "compression",
    "image",
    "pdf",
    "client-side",
    "browser",
    "jpeg",
    "png",
    "optimize",
    "resize"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "sideEffects": false
}
