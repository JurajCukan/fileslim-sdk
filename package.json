{
  "name": "@fileslim/compress",
  "version": "1.0.0",
  "description": "Client-side file compression library - compress images and PDFs in the browser with zero server costs",
  "author": "FileSlim",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "compression",
    "image",
    "pdf",
    "browser",
    "client-side",
    "file-compression",
    "optimize",
    "webp",
    "avif",
    "jpeg",
    "png"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fileslim/sdk"
  },
  "homepage": "https://fileslim.com/sdk",
  "bugs": {
    "url": "https://github.com/fileslim/sdk/issues"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "jszip": "^3.10.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  },
  "peerDependencies": {},
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  }
}
